# --- Telegram-бот ---
BOT_TOKEN=your-telegram-bot-token-here
ADMIN_CHAT_IDS=123456789,987654321
REVIEW_CHAT_ID=-100XXXXXXXXXX

# --- Модуль мерч-кодов ---
# Поддомен, на котором работает генерация и проверка кодов.
# У него должна быть A-запись в DNS на IP этого сервера.
MERCH_DOMAIN=code.catalist.world

# Публичный адрес для ссылок в письмах и QR-кодов скидок.
# Обычно оставляйте пустым (возьмётся https://MERCH_DOMAIN).
# Пока DNS не настроен — раскомментируйте и укажите адрес по IP,
# после включения домена уберите эту строку и выполните deploy.
# MERCH_PUBLIC_URL=http://209.38.205.133:8080

# PIN оператора производства: генерация и сохранение номеров, просмотр журнала.
MERCH_PRODUCTION_PIN=

# PIN администратора: всё то же плюс правка каталога и удаление записей.
# Оба PIN обязательны (минимум 4 знака, должны отличаться) — без них
# служебные функции модуля отключены.
MERCH_ADMIN_PIN=

# Ключ шифрования серийных номеров (32 hex-символа, 128 бит).
# Оставьте пустым — при первом запуске сервис сгенерирует ключ сам и положит
# копию в /app/data/serial-key.backup.json (см. docs/merch-module.md, «Бэкапы»).
# Заполняется только при восстановлении из резервной копии.
MERCH_SERIAL_KEY=

# Вход через Google (OAuth 2.0). Как получить — docs/google-oauth-setup.md.
# Пока не заполнено, персонал входит по PIN-кодам выше.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email-адреса, получающие роль администратора при входе через Google
# (через запятую). Первый администратор системы.
MERCH_ADMIN_EMAILS=mednovdmitry@gmail.com

# --- Почта покупателям (скидка за регистрацию, вход в личный кабинет) ---
# Любой SMTP-сервис: Gmail (пароль приложения), Brevo, Mailgun, Zoho и т.п.
# Пока не заполнено, письма не отправляются; скидки и кабинет работают.
MERCH_SMTP_HOST=
MERCH_SMTP_PORT=587
MERCH_SMTP_USER=
MERCH_SMTP_PASSWORD=
# Адрес отправителя (по умолчанию — MERCH_SMTP_USER)
MERCH_SMTP_FROM=
# starttls (порт 587) | ssl (порт 465) | none
MERCH_SMTP_SECURITY=starttls

# Процент скидки за регистрацию фигурки
MERCH_DISCOUNT_PERCENT=10

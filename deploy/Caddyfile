# Reverse-proxy для модуля мерч-кодов.
# Домен берётся из переменной MERCH_DOMAIN (docker-compose.yml → .env).
# Caddy сам выпускает и продлевает сертификат Let's Encrypt — для этого
# у поддомена должна быть A-запись на IP сервера и открыты порты 80/443.
#
# Чтобы получать письма Let's Encrypt об истечении сертификата,
# раскомментируйте блок и укажите почту:
# {
#     email admin@catalist.world
# }

# Временный технологический доступ по IP, пока не настроен DNS поддомена:
#   http://<IP сервера>:8080
# Трафик здесь не шифруется. После появления A-записи и проверки https-адреса
# удалите этот блок и проброс порта 8080:8080 из docker-compose.yml,
# затем: docker compose up -d caddy
http://:8080 {
    reverse_proxy merch:8000
}

{$MERCH_DOMAIN} {
    encode gzip

    # Кэшируем статику, API не кэшируем
    @static path /static/*
    header @static Cache-Control "public, max-age=86400"
    header /api/* Cache-Control "no-store"

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy merch:8000
}
